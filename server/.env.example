PORT=4000
# JWT signing secret for authentication tokens
JWT_SECRET=YourJwtSecret2026
# HMAC secret used by PoA validators to seal blocks
VALIDATOR_SECRET=YourStrongPoAValidatorSealingKey2026
# Optional: Twilio SMS
TWILIO_SID=your_account_sid
TWILIO_TOKEN=your_auth_token
TWILIO_FROM=+1XXXXXXXXXX
# Signed download URL expiry in seconds (default 24h)
DOWNLOAD_URL_EXPIRY=86400